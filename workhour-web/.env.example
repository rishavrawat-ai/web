DATABASE_URL=postgres://workhour:workhour_local@127.0.0.1:55432/workhour
PAYLOAD_SECRET=replace-with-a-long-random-secret
BRAND_HOSTS=inceptura.localhost=inceptura,employaa.localhost=employaa,remunerax.localhost=remunerax,gotravelglobal.localhost=gotravelglobal,elevatrain.localhost=elevatrain,thinkrunspace.localhost=thinkrunspace,leaderspinnacle.localhost=leaderspinnacle
MEDIA_STORAGE_PROVIDER=local
# Production: set MEDIA_STORAGE_PROVIDER=s3 and provide S3_BUCKET and S3_REGION.
S3_BUCKET=
S3_REGION=
# Optional for S3-compatible services such as MinIO, R2, or Spaces.
S3_ENDPOINT=
# Optional for static credentials. Omit both on AWS when using an IAM role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Defaults to true when S3_ENDPOINT is set; AWS S3 defaults to false.
S3_FORCE_PATH_STYLE=
